// Bank Sampah Sukamaju Sejahtera + Koperasi Simpan Pinjam
// Recreated from Laravel/MySQL dump into Next.js + Prisma (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== MASTER: USERS & ROLES ====================

model Pengguna {
  id              String    @id @default(cuid())
  memberCode      String?   @unique
  name            String
  email           String    @unique
  nik             String?   @unique
  roles           String    @default("[]") // JSON array string e.g. ["admin","nasabah"]
  phone           String?
  address         String?
  tempatLahir     String?
  tanggalLahir    DateTime?
  jenisKelamin    String?
  rt              String?
  rw              String?
  desaKelurahan   String?
  kecamatan       String?
  pekerjaan       String?
  fotoKtp         String?
  isMember        Boolean   @default(false)
  memberJoinedAt  DateTime?
  emailVerifiedAt DateTime?
  password        String    @default("password")
  // OTP untuk verifikasi email (dikirim via Resend email service)
  otpCode         String? // 6-digit OTP code
  otpExpiresAt    DateTime? // kapan OTP expired (default 10 menit)
  otpAttempts     Int       @default(0) // jumlah salah coba OTP (max 5)

  // Verifikasi 2-Langkah
  verificationStatus String    @default("pending_otp") // "pending_otp", "pending_admin", "verified"
  adminVerifiedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saldo                   Saldo?
  balanceHistories        RiwayatSaldo[]              @relation("BalanceHistoryUser")
  pointHistories          RiwayatPoin[]               @relation("PointHistoryUser")
  pencairanPoins          PencairanPoin[]             @relation("PointCashOutUser")
  transaksiNabungs        TransaksiNabung[]           @relation("SavingUser")
  transaksiSedekahs       TransaksiSedekah[]          @relation("SedekahUser")
  withdrawals             PermintaanPenarikan[]       @relation("WithdrawalUser")
  penukaranPoins          PenukaranPoin[]             @relation("RedemptionUser")
  articles                Article[]
  kegiatans               Kegiatan[]
  koperasiAnggota         KoperasiAnggota?
  createdSavingTx         TransaksiNabung[]           @relation("SavingCreatedBy")
  createdSedekahTx        TransaksiSedekah[]          @relation("SedekahCreatedBy")
  createdBalanceHistories RiwayatSaldo[]              @relation("BalanceHistoryCreatedBy")
  createdPointHistories   RiwayatPoin[]               @relation("PointHistoryCreatedBy")
  createdSalesTx          TransaksiPenjualanMitra[]   @relation("SalesCreatedBy")
  createdProcessingTx     TransaksiPengolahan[]       @relation("ProcessingCreatedBy")
  createdProductSale      PenjualanProduk[]           @relation("ProductSaleCreatedBy")
  boughtProductSales      PenjualanProduk[]           @relation("ProductSaleBuyer")
  createdProductPrice     HargaProduk[]               @relation("ProductPriceCreatedBy")
  createdProductMovement  PergerakanProduk[]          @relation("ProductMovementCreatedBy")
  createdWastePrice       HargaSampah[]               @relation("WastePriceCreatedBy")
  createdPointRule        AturanPoin[]                @relation("PointRuleCreatedBy")
  createdInventoryMvmt    PergerakanInventaris[]      @relation("InventoryMovementCreatedBy")
  createdSimpananTx       KoperasiSimpananTransaksi[] @relation("SimpananCreatedBy")
  createdPinjaman         KoperasiPinjaman[]          @relation("PinjamanCreatedBy")
  approvedPinjamans       KoperasiPinjaman[]          @relation("PinjamanApprovedBy")
  createdAngsuran         KoperasiPinjamanAngsuran[]  @relation("AngsuranCreatedBy")
  createdKasTx            KoperasiKasTransaksi[]      @relation("KasCreatedBy")
  createdAnggotaKeluar    KoperasiAnggotaKeluar[]     @relation("AnggotaKeluarCreatedBy")
  reviewedPerbaikan       KoperasiPinjamanPerbaikan[] @relation("PerbaikanReviewedBy")
  qcSavingTx              TransaksiNabung[]           @relation("SavingQcBy")
  qcSedekahTx             TransaksiSedekah[]          @relation("SedekahQcBy")
  filterSedekahTx         TransaksiSedekah[]          @relation("SedekahFilterBy")
  processedWithdrawal     PermintaanPenarikan[]       @relation("WithdrawalProcessedBy")
  processedRedemption     PenukaranPoin[]             @relation("RedemptionProcessedBy")
  processedPointCashOut   PencairanPoin[]             @relation("PointCashOutProcessedBy")
  balanceReleasesAsUser   PelepasanSaldo[]            @relation("BalanceReleaseUser")
  pelepasanSaldos         PelepasanSaldo[]            @relation("BalanceReleaseReleasedBy")
  bankSampahKasCreated    KasBankSampah[]             @relation("BankSampahKasCreatedBy")
  createdTokoOrder        PesananToko[]               @relation("TokoOrderCreatedBy")
  createdTokoStatus       RiwayatStatusPesananToko[]  @relation("TokoStatusCreatedBy")
  notifikasis             Notifikasi[]                @relation("NotificationUser")
}

model Notifikasi {
  id         String   @id @default(cuid())
  penggunaId String
  title      String
  message    String   @db.Text
  isRead     Boolean  @default(false)
  type       String   @default("info")
  link       String?
  createdAt  DateTime @default(now())

  pengguna Pengguna @relation("NotificationUser", fields: [penggunaId], references: [id])
}

model PenghitungKodeAnggota {
  id         String   @id @default(cuid())
  prefix     String   @unique
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==================== MASTER: WASTE CATALOG ====================

model KategoriSampah {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  codePrefix  String        @unique
  description String?
  image       String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       JenisSampah[]
}

model JenisSampah {
  id               String   @id @default(cuid())
  kategoriSampahId String
  code             String   @unique
  name             String
  slug             String   @unique
  unit             String   @default("kg")
  pricePerUnit     Decimal  @default(0)
  description      String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category              KategoriSampah                @relation(fields: [kategoriSampahId], references: [id])
  prices                HargaSampah[]
  savingItems           ItemTransaksiNabung[]
  sedekahItems          ItemTransaksiSedekah[]
  salesItems            ItemTransaksiPenjualanMitra[]
  inputPengolahans      InputPengolahan[]
  inventories           Inventaris[]
  pergerakanInventariss PergerakanInventaris[]
  recipeItems           ResepPengolahan[] // resep pengolahan (bahan baku untuk produk)
}

model HargaSampah {
  id            String   @id @default(cuid())
  jenisSampahId String
  pricePerUnit  Decimal
  effectiveFrom DateTime
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jenisSampah JenisSampah           @relation(fields: [jenisSampahId], references: [id])
  createdBy   Pengguna?             @relation("WastePriceCreatedBy", fields: [createdById], references: [id])
  savingItems ItemTransaksiNabung[]
}

// ==================== MASTER: POINT RULES ====================

model AturanPoin {
  id                 String   @id @default(cuid())
  pointsPerRupiah    Decimal // poin per Rp setoran (mis. 0.001 = 1 poin / Rp 1000)
  rupiahPerPointEarn Int      @default(1000) // nilai rupiah tabungan untuk mendapatkan 1 poin (mis. 1000, 2000, 500)
  rupiahPerPoint     Decimal  @default(0) // nilai 1 poin dalam Rupiah (untuk cash out / tukar produk)
  effectiveFrom      DateTime
  notes              String?
  isActive           Boolean  @default(true)
  // ===== Aturan Loyalty =====
  resetPeriod        String   @default("never") // never | monthly | quarterly | yearly
  resetDay           Int      @default(1) // tanggal reset (1-28), default awal bulan
  minRedeemPoints    Int      @default(50) // minimal poin untuk redeem/cashout
  expiryDays         Int      @default(0) // poin expired setelah X hari (0 = tidak expired)
  rolloverPoints     Int      @default(0) // poin maksimal yang rollover saat reset (0 = semua hangus)
  // ===== Tier Multiplier (bonus poin berdasarkan tier nasabah) =====
  tierBronzeMult     Decimal  @default(1) // multiplier untuk tier Bronze (0-499 poin)
  tierSilverMult     Decimal  @default(1.2) // multiplier untuk tier Silver (500-999 poin)
  tierGoldMult       Decimal  @default(1.5) // multiplier untuk tier Gold (1000-2499 poin)
  tierPlatinumMult   Decimal  @default(2) // multiplier untuk tier Platinum (2500+ poin)
  // ===== Streak Bonus =====
  streakBonusEnabled Boolean  @default(true) // aktifkan bonus setoran berturut-turut
  streakBonusMonths  Int      @default(3) // minimal bulan berturut-turut untuk dapat bonus
  streakBonusMult    Decimal  @default(1.5) // multiplier bonus streak
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  createdBy      Pengguna?       @relation("PointRuleCreatedBy", fields: [createdById], references: [id])
  pointHistories RiwayatPoin[]
  pencairanPoins PencairanPoin[]
}

// ==================== BALANCE & POINTS ====================

model Saldo {
  id            String   @id @default(cuid())
  penggunaId    String   @unique
  saldoTertahan Decimal  @default(0) // held saldo (from savings, can be withdrawn/cash-out)
  saldoTersedia Decimal  @default(0) // available saldo (after cash-out approval etc.)
  points        Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pengguna Pengguna @relation(fields: [penggunaId], references: [id])
}

model RiwayatSaldo {
  id           String   @id @default(cuid())
  penggunaId   String
  bucket       String // saldo_tertahan | saldo_tersedia | points
  type         String // credit | debit
  amount       Decimal
  balanceAfter Decimal
  sourceType   String?
  sourceId     String?
  description  String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pengguna  Pengguna  @relation("BalanceHistoryUser", fields: [penggunaId], references: [id])
  createdBy Pengguna? @relation("BalanceHistoryCreatedBy", fields: [createdById], references: [id])
}

model RiwayatPoin {
  id           String   @id @default(cuid())
  penggunaId   String
  aturanPoinId String?
  type         String // earn | cash_out | redeem
  points       Int
  balanceAfter Int
  rateSnapshot Decimal?
  sourceType   String?
  sourceId     String?
  description  String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pengguna   Pengguna    @relation("PointHistoryUser", fields: [penggunaId], references: [id])
  aturanPoin AturanPoin? @relation(fields: [aturanPoinId], references: [id])
  createdBy  Pengguna?   @relation("PointHistoryCreatedBy", fields: [createdById], references: [id])
}

model PencairanPoin {
  id            String   @id @default(cuid())
  penggunaId    String
  aturanPoinId  String?
  pointsUsed    Int
  rateSnapshot  Decimal
  cashAmount    Decimal
  notes         String?
  processedById String?
  cashedOutAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pengguna    Pengguna    @relation("PointCashOutUser", fields: [penggunaId], references: [id])
  aturanPoin  AturanPoin? @relation(fields: [aturanPoinId], references: [id])
  processedBy Pengguna?   @relation("PointCashOutProcessedBy", fields: [processedById], references: [id])
}

// ==================== OPERASIONAL: NABUNG SAMPAH ====================

model TransaksiNabung {
  id                      String    @id @default(cuid())
  penggunaId              String
  // Kode transaksi resmi (format: NB / DDMMYYYY / 00001) — disimpan saat create
  kodeTransaksi           String?
  totalWeight             Decimal   @default(0)
  totalValue              Decimal   @default(0)
  pointsAwarded           Int       @default(0)
  notes                   String?
  createdById             String?
  transactedAt            DateTime  @default(now())
  // Status transaksi: menunggu_qc | selesai | dibatalkan
  // - menunggu_qc: transaksi dibuat, saldo BELUM masuk (menunggu QC konfirmasi)
  // - selesai: QC selesai (atau tidak_perlu_qc) → saldo sudah masuk
  // - dibatalkan: dibatalkan saat QC (0kg diterima), saldo tidak masuk sama sekali
  status                  String    @default("menunggu_qc")
  // QC flow: pending (default menunggu QC) | tidak_perlu (teller tandai bersih) | passed | adjusted | rejected
  qcStatus                String    @default("pending") // pending | tidak_perlu | passed | adjusted | rejected
  qcAt                    DateTime?
  qcById                  String?
  qcNotes                 String?
  qcReason                String? // alasan utama pembatalan/penolakan
  rejectedAction          String? // null | "sedekah" | "ambil_kembali"
  isRejectedWastePickedUp Boolean   @default(false)
  finalizedAt             DateTime? // kapan saldo dikredit (saat status → selesai)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  pengguna  Pengguna              @relation("SavingUser", fields: [penggunaId], references: [id])
  createdBy Pengguna?             @relation("SavingCreatedBy", fields: [createdById], references: [id])
  qcBy      Pengguna?             @relation("SavingQcBy", fields: [qcById], references: [id])
  items     ItemTransaksiNabung[]
}

model ItemTransaksiNabung {
  id                   String   @id @default(cuid())
  transaksiNabungId    String
  jenisSampahId        String
  hargaSampahId        String?
  itemCodeSnapshot     String
  itemNameSnapshot     String
  categoryNameSnapshot String
  unitSnapshot         String   @default("kg")
  pricePerUnitSnapshot Decimal
  quantity             Decimal
  subtotal             Decimal
  quantityBeforeQc     Decimal  @default(0)
  quantityAfterQc      Decimal?
  susutQc              Decimal  @default(0)
  subtotalBeforeQc     Decimal  @default(0)
  qcReason             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  transaksiNabung TransaksiNabung @relation(fields: [transaksiNabungId], references: [id])
  jenisSampah     JenisSampah     @relation(fields: [jenisSampahId], references: [id])
  hargaSampah     HargaSampah?    @relation(fields: [hargaSampahId], references: [id])
}

// ==================== OPERASIONAL: SEDEKAH SAMPAH ====================

model TransaksiSedekah {
  id                String    @id @default(cuid())
  penggunaId        String?
  donorName         String?
  // Kode transaksi resmi (format: SD / DDMMYYYY / 00001) — disimpan saat create
  kodeTransaksi     String?
  totalWeight       Decimal   @default(0)
  notes             String?
  createdById       String?
  transactedAt      DateTime  @default(now())
  // Status: menunggu_qc | selesai | dibatalkan (sinkron dengan TransaksiNabung)
  status            String    @default("menunggu_qc")
  qcStatus          String    @default("pending") // pending | tidak_perlu | passed | adjusted | rejected
  qcAt              DateTime?
  qcById            String?
  qcNotes           String?
  qcReason          String?
  finalizedAt       DateTime?
  totalWeightKotor  Decimal   @default(0)
  totalWeightBersih Decimal?
  persentaseSusut   Decimal?
  filterNotes       String?
  filterAt          DateTime?
  filterById        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  pengguna  Pengguna?              @relation("SedekahUser", fields: [penggunaId], references: [id])
  createdBy Pengguna?              @relation("SedekahCreatedBy", fields: [createdById], references: [id])
  qcBy      Pengguna?              @relation("SedekahQcBy", fields: [qcById], references: [id])
  filterBy  Pengguna?              @relation("SedekahFilterBy", fields: [filterById], references: [id])
  items     ItemTransaksiSedekah[]
}

model ItemTransaksiSedekah {
  id                   String   @id @default(cuid())
  transaksiSedekahId   String
  jenisSampahId        String
  itemCodeSnapshot     String
  itemNameSnapshot     String
  categoryNameSnapshot String
  unitSnapshot         String   @default("kg")
  quantity             Decimal
  quantityBeforeQc     Decimal  @default(0)
  quantityAfterQc      Decimal?
  susutQc              Decimal  @default(0)
  qcReason             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  transaksiSedekah TransaksiSedekah @relation(fields: [transaksiSedekahId], references: [id])
  jenisSampah      JenisSampah      @relation(fields: [jenisSampahId], references: [id])
}

// ==================== INVENTORY ====================

model Inventaris {
  id            String   @id @default(cuid())
  jenisSampahId String
  source        String // nabung | sedekah | processing_output | sale_return
  stock         Decimal  @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jenisSampah JenisSampah @relation(fields: [jenisSampahId], references: [id])

  @@unique([jenisSampahId, source])
}

model PergerakanInventaris {
  id            String   @id @default(cuid())
  jenisSampahId String
  source        String
  direction     String // in | out
  reason        String // saving | sedekah | processing_input | sale | adjustment
  quantity      Decimal
  stockAfter    Decimal
  sourceRefType String?
  sourceRefId   String?
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jenisSampah JenisSampah @relation(fields: [jenisSampahId], references: [id])
  createdBy   Pengguna?   @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id])
}

// ==================== PARTNERS & SALES (to mitra) ====================

model Mitra {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("pengepul")
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transaksiPenjualanMitras TransaksiPenjualanMitra[]
}

model TransaksiPenjualanMitra {
  id            String   @id @default(cuid())
  invoiceNumber String?  @unique
  mitraId       String
  totalWeight   Decimal  @default(0)
  totalValue    Decimal  @default(0)
  notes         String?
  createdById   String?
  transactedAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mitra     Mitra                         @relation(fields: [mitraId], references: [id])
  createdBy Pengguna?                     @relation("SalesCreatedBy", fields: [createdById], references: [id])
  items     ItemTransaksiPenjualanMitra[]
}

model ItemTransaksiPenjualanMitra {
  id                        String   @id @default(cuid())
  transaksiPenjualanMitraId String
  jenisSampahId             String
  itemCodeSnapshot          String
  itemNameSnapshot          String
  categoryNameSnapshot      String
  unitSnapshot              String   @default("kg")
  pricePerUnit              Decimal
  quantity                  Decimal
  subtotal                  Decimal
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  transaksiPenjualanMitra TransaksiPenjualanMitra @relation(fields: [transaksiPenjualanMitraId], references: [id])
  jenisSampah             JenisSampah             @relation(fields: [jenisSampahId], references: [id])
}

// ==================== PRODUCT CATEGORY (E-COMMERCE) ====================

model KategoriProduk {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  produks         Produk[]
  aturanPenjualan AturanPenjualan[]
}

// ==================== PRODUCTS & PROCESSING ====================

model Produk {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?
  image            String?
  images           String   @default("[]") // JSON array of image URLs
  unit             String   @default("pcs")
  price            Decimal  @default(0)
  pointsCost       Int      @default(0)
  dijualDenganPoin Boolean  @default(false) // produk ini bisa ditukar dengan poin
  stock            Decimal  @default(0)
  isActive         Boolean  @default(true)
  // E-commerce fields
  kategoriProdukId String?
  weightGram       Int      @default(0) // berat produk dalam gram (wajib untuk ongkir)
  lengthCm         Int      @default(0) // dimensi panjang (opsional, volumetrik)
  widthCm          Int      @default(0) // dimensi lebar
  heightCm         Int      @default(0) // dimensi tinggi
  dijualOnline     Boolean  @default(false)
  dijualOffline    Boolean  @default(true)
  minOrderQty      Int      @default(1) // minimal pembelian per item
  maxOrderQty      Int      @default(0) // 0 = tidak ada batas
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category          KategoriProduk?       @relation(fields: [kategoriProdukId], references: [id])
  prices            HargaProduk[]
  movements         PergerakanProduk[]
  outputPengolahans OutputPengolahan[]
  saleItems         ItemPenjualanProduk[]
  penukaranPoins    PenukaranPoin[]
  itemPesananTokos  ItemPesananToko[]
  recipes           ResepPengolahan[] // resep pengolahan (produk hasil)
}

model HargaProduk {
  id            String   @id @default(cuid())
  produkId      String
  pricePerUnit  Decimal
  effectiveFrom DateTime
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  produk    Produk                @relation(fields: [produkId], references: [id])
  createdBy Pengguna?             @relation("ProductPriceCreatedBy", fields: [createdById], references: [id])
  saleItems ItemPenjualanProduk[]
}

model PergerakanProduk {
  id             String   @id @default(cuid())
  movementNumber String?  @unique
  produkId       String
  direction      String // in | out
  reason         String // processing_output | sale | penukaranPoin | adjustment | online_sale | online_reserve | online_release
  quantity       Decimal
  stockAfter     Decimal
  sourceRefType  String?
  sourceRefId    String?
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  produk    Produk    @relation(fields: [produkId], references: [id])
  createdBy Pengguna? @relation("ProductMovementCreatedBy", fields: [createdById], references: [id])
}

model PenjualanProduk {
  id            String   @id @default(cuid())
  invoiceNumber String?  @unique
  buyerUserId   String?
  buyerName     String
  buyerPhone    String
  paymentMethod String   @default("cash")
  paymentStatus String   @default("paid")
  totalQuantity Decimal
  totalValue    Decimal
  channel       String   @default("offline") // offline | online
  notes         String?
  createdById   String?
  transactedAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  buyer     Pengguna?             @relation("ProductSaleBuyer", fields: [buyerUserId], references: [id])
  createdBy Pengguna?             @relation("ProductSaleCreatedBy", fields: [createdById], references: [id])
  items     ItemPenjualanProduk[]
}

model ItemPenjualanProduk {
  id                   String   @id @default(cuid())
  penjualanProdukId    String
  produkId             String
  hargaProdukId        String?
  productNameSnapshot  String
  unitSnapshot         String
  pricePerUnitSnapshot Decimal
  quantity             Decimal
  subtotal             Decimal
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  penjualanProduk PenjualanProduk @relation(fields: [penjualanProdukId], references: [id])
  produk          Produk          @relation(fields: [produkId], references: [id])
  hargaProduk     HargaProduk?    @relation(fields: [hargaProdukId], references: [id])
}

model TransaksiPengolahan {
  id                    String   @id @default(cuid())
  totalInputWeight      Decimal  @default(0)
  totalHppBahanBaku     Decimal  @default(0) // Total HPP bahan baku (harga beli × qty dari sumber nabung)
  totalBiayaOperasional Decimal  @default(0) // Total biaya operasional (tenaga kerja, bahan pendukung, dll)
  totalBiayaProduksi    Decimal  @default(0) // = totalHppBahanBaku + totalBiayaOperasional
  status                String   @default("selesai") // selesai | dibatalkan
  notes                 String?
  createdById           String?
  transactedAt          DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  createdBy  Pengguna?          @relation("ProcessingCreatedBy", fields: [createdById], references: [id])
  inputs     InputPengolahan[]
  outputs    OutputPengolahan[]
  biayaItems BiayaPengolahan[]
}

model InputPengolahan {
  id                    String   @id @default(cuid())
  transaksiPengolahanId String
  jenisSampahId         String
  itemCodeSnapshot      String
  itemNameSnapshot      String
  categoryNameSnapshot  String
  unitSnapshot          String   @default("kg")
  quantity              Decimal
  source                String   @default("nabung") // nabung | sedekah
  hargaSatuan           Decimal  @default(0) // snapshot harga beli saat pengolahan
  subtotal              Decimal  @default(0) // hargaSatuan × quantity (HPP per item)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  transaksiPengolahan TransaksiPengolahan @relation(fields: [transaksiPengolahanId], references: [id])
  jenisSampah         JenisSampah         @relation(fields: [jenisSampahId], references: [id])
}

model OutputPengolahan {
  id                    String   @id @default(cuid())
  transaksiPengolahanId String
  produkId              String
  productNameSnapshot   String
  unitSnapshot          String   @default("pcs")
  quantity              Decimal
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  transaksiPengolahan TransaksiPengolahan @relation(fields: [transaksiPengolahanId], references: [id])
  produk              Produk              @relation(fields: [produkId], references: [id])
}

// ==================== RESEP PENGOLAHAN (1 produk = N kg bahan baku) ====================
// Pengaturan otomatis: kalau aktif, input bahan baku auto-terisi saat pilih produk
// Contoh: 1 Vas Bunga = 1.67 kg Dus → pengguna tinggal isi qty produk, bahan auto-hitung

model ResepPengolahan {
  id              String   @id @default(cuid())
  produkId        String // produk hasil
  jenisSampahId   String // bahan baku
  quantityPerUnit Decimal // jumlah bahan baku per 1 unit produk (mis. 1.67 kg per 1 pcs)
  source          String   @default("nabung") // sumber stok: nabung | sedekah
  isActive        Boolean  @default(true) // true = resep aktif (auto-fill), false = manual
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  produk      Produk      @relation(fields: [produkId], references: [id])
  jenisSampah JenisSampah @relation(fields: [jenisSampahId], references: [id])

  @@unique([produkId, jenisSampahId]) // 1 produk + 1 bahan baku = 1 resep
  @@index([produkId])
}

// ==================== BIAYA PENGOLAHAN (rincian biaya produksi per transaksi) ====================
// Mencatat biaya operasional: tenaga kerja, bahan pendukung (lem, benang), transportasi, listrik, dll

model BiayaPengolahan {
  id                    String   @id @default(cuid())
  transaksiPengolahanId String
  kategori              String   // tenaga_kerja | bahan_pendukung | transportasi | listrik | lainnya
  keterangan            String   // contoh: "Upah jahit 2 orang x 3 jam", "Beli lem 2 botol"
  jumlah                Decimal
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  transaksiPengolahan TransaksiPengolahan @relation(fields: [transaksiPengolahanId], references: [id])

  @@index([transaksiPengolahanId])
}

// ==================== REDEMPTION (poin -> produk) & WITHDRAWAL ====================

model PenukaranPoin {
  id                  String   @id @default(cuid())
  penggunaId          String
  produkId            String?
  productNameSnapshot String
  unitSnapshot        String   @default("pcs")
  quantity            Decimal
  pointsUsed          Int
  notes               String?
  processedById       String?
  redeemedAt          DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  pengguna    Pengguna  @relation("RedemptionUser", fields: [penggunaId], references: [id])
  produk      Produk?   @relation(fields: [produkId], references: [id])
  processedBy Pengguna? @relation("RedemptionProcessedBy", fields: [processedById], references: [id])
}

model PermintaanPenarikan {
  id            String   @id @default(cuid())
  penggunaId    String
  amount        Decimal
  method        String   @default("cash")
  bankName      String?
  accountNumber String?
  accountName   String?
  notes         String?
  // Financial flow: withdrawal cuts from saldoTersedia (validated in real-time)
  // and records a kas keluar in KasBankSampah (Buku Kas Utama institusi)
  status        String   @default("diproses") // diproses | sukses | ditolak
  receiptNo     String?  @unique
  processedById String?
  processedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pengguna    Pengguna  @relation("WithdrawalUser", fields: [penggunaId], references: [id])
  processedBy Pengguna? @relation("WithdrawalProcessedBy", fields: [processedById], references: [id])
}

// Buku Kas Utama institusi Bank Sampah (source of truth for cash liquidity)
// All cash in (penjualan ke mitra, produk, dll) and cash out (penarikan nasabah, biaya) recorded here
// Used to validate Release Saldo: only release if kas saldo >= total saldo tertahan being released
model KasBankSampah {
  id                String   @id @default(cuid())
  buku              String   @default("utama") // utama | nasabah
  tipe              String // masuk | keluar
  sumber            String // penjualan_mitra | penjualan_produk | penarikan_nasabah | biaya_operasional | setoran_awal | penyesuaian
  jumlah            Decimal
  saldoSetelah      Decimal
  keterangan        String?
  // optional links
  withdrawalId      String?
  salesTxId         String?
  penjualanProdukId String?
  createdById       String?
  transactedAt      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdBy Pengguna? @relation("BankSampahKasCreatedBy", fields: [createdById], references: [id])
}

// Log of Release Saldo operations (saldoTertahan → saldoTersedia)
// Each release records who/when/how much, for audit trail
model PelepasanSaldo {
  id                    String   @id @default(cuid())
  penggunaId            String
  amount                Decimal
  saldoTertahanSebelum  Decimal
  saldoTertahanSesudah  Decimal
  saldoTersediaSebelum  Decimal
  saldoTersediaSesudah  Decimal
  keterangan            String?
  // Validation: at release time, snapshot kas institusi to prove liquidity
  kasSaldoSnapshot      Decimal
  totalTertahanSnapshot Decimal
  releasedById          String?
  releasedAt            DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  pengguna   Pengguna  @relation("BalanceReleaseUser", fields: [penggunaId], references: [id])
  releasedBy Pengguna? @relation("BalanceReleaseReleasedBy", fields: [releasedById], references: [id])
}

// ==================== KOPERASI: SETTINGS ====================

model KoperasiSetting {
  id                    String    @id @default(cuid())
  namaKoperasi          String
  telepon               String?
  email                 String?
  alamat                String?
  logo                  String?
  nominalSimpananPokok  Decimal   @default(0)
  nominalSimpananWajib  Decimal   @default(0)
  biayaAdminPinjaman    Decimal   @default(0)
  minimalBulanAnggota   Int       @default(3)
  minimalSimpananPinjaman Decimal @default(0)
  saldoKasAwal          Decimal   @default(0)
  tanggalSaldoAwal      DateTime?
  dendaTerlambatPerHari Int       @default(0)
  sukuBungaPinjaman     Decimal   @default(0) // persen flat per tahun
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// ==================== KOPERASI: ANGGOTA ====================

model KoperasiAnggota {
  id                String                      @id @default(cuid())
  nomorAnggota      String                      @unique
  nama              String
  noKtp             String
  noTelepon         String?
  alamat            String?
  foto              String?
  status            String                      @default("aktif") // aktif | pasif | keluar
  tanggalBergabung  DateTime
  tanggalKeluar     DateTime?
  deletedAt         DateTime?
  pinjamanDiblokir  Boolean                     @default(false) // true = tidak bisa pinjam (riwayat jelek, menunggu perbaikan)
  perbaikanRequests KoperasiPinjamanPerbaikan[]
  penggunaId        String?                     @unique
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  pengguna          Pengguna?                   @relation(fields: [penggunaId], references: [id])
  simpananSaldos    KoperasiSimpananSaldo[]
  simpananTx        KoperasiSimpananTransaksi[]
  pinjamans         KoperasiPinjaman[]
  penarikanSukarela KoperasiPenarikanSukarela[]
  anggotaKeluars    KoperasiAnggotaKeluar[]
}

model KoperasiAnggotaKeluar {
  id                String   @id @default(cuid())
  koperasiAnggotaId String
  totalSimpanan     Decimal
  sisaPinjaman      Decimal
  danaDikembalikan  Decimal
  tanggalKeluar     DateTime
  keterangan        String?
  penggunaId        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  anggota   KoperasiAnggota @relation(fields: [koperasiAnggotaId], references: [id])
  createdBy Pengguna?       @relation("AnggotaKeluarCreatedBy", fields: [penggunaId], references: [id])
}

// ==================== KOPERASI: SIMPANAN ====================

model KoperasiSimpananSaldo {
  id                String   @id @default(cuid())
  koperasiAnggotaId String
  jenisSimpanan     String // pokok | wajib | sukarela
  saldo             Decimal  @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  anggota KoperasiAnggota @relation(fields: [koperasiAnggotaId], references: [id])

  @@unique([koperasiAnggotaId, jenisSimpanan])
}

model KoperasiSimpananTransaksi {
  id                String   @id @default(cuid())
  nomorTransaksi    String   @unique
  koperasiAnggotaId String
  jenisSimpanan     String // pokok | wajib | sukarela
  tipe              String // setor | tarik
  jumlah            Decimal
  saldoSebelum      Decimal
  saldoSesudah      Decimal
  keterangan        String?
  tanggalTransaksi  DateTime @default(now())
  penggunaId        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  anggota   KoperasiAnggota @relation(fields: [koperasiAnggotaId], references: [id])
  createdBy Pengguna?       @relation("SimpananCreatedBy", fields: [penggunaId], references: [id])
}

// ==================== KOPERASI: PINJAMAN & ANGSURAN ====================

model KoperasiPinjaman {
  id                String    @id @default(cuid())
  nomorPinjaman     String    @unique
  koperasiAnggotaId String
  jumlahPinjaman    Decimal
  tenorBulan        Int
  angsuranPerBulan  Decimal
  biayaAdmin        Decimal   @default(0)
  tanggalPengajuan  DateTime  @default(now())
  tanggalPencairan  DateTime?
  status            String    @default("diajukan") // diajukan | disetujui | ditolak | berjalan | lunas
  sisaPinjaman      Decimal
  sukuBunga         Decimal   @default(0) // persen flat per tahun
  keterangan        String?
  penggunaId        String?
  disetujuiOlehId   String?
  disetujuiPada     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  anggota       KoperasiAnggota            @relation(fields: [koperasiAnggotaId], references: [id])
  createdBy     Pengguna?                  @relation("PinjamanCreatedBy", fields: [penggunaId], references: [id])
  disetujuiOleh Pengguna?                  @relation("PinjamanApprovedBy", fields: [disetujuiOlehId], references: [id])
  angsurans     KoperasiPinjamanAngsuran[]
}

model KoperasiPinjamanAngsuran {
  id                  String   @id @default(cuid())
  nomorAngsuran       String?  @unique
  koperasiPinjamanId  String
  angsuranKe          Int
  jumlahBayar         Decimal
  dendaBayar          Int      @default(0)
  tanggalBayar        DateTime @default(now())
  sisaPinjamanSetelah Decimal
  keterangan          String?
  penggunaId          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  pinjaman  KoperasiPinjaman @relation(fields: [koperasiPinjamanId], references: [id])
  createdBy Pengguna?        @relation("AngsuranCreatedBy", fields: [penggunaId], references: [id])

  @@unique([koperasiPinjamanId, angsuranKe])
}

// ==================== KOPERASI: KAS & PENARIKAN SUKARELA ====================

model KoperasiKasTransaksi {
  id               String   @id @default(cuid())
  nomorKas         String?  @unique
  nomorReferensi   String?
  sumber           String // simpanan | penarikan | pinjaman | angsuran | denda | saldo_awal
  tipe             String // masuk | keluar
  jumlah           Decimal
  keterangan       String?
  tanggalTransaksi DateTime @default(now())
  penggunaId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdBy Pengguna? @relation("KasCreatedBy", fields: [penggunaId], references: [id])
}

model KoperasiPenarikanSukarela {
  id                 String    @id @default(cuid())
  nomorPengajuan     String    @unique
  koperasiAnggotaId  String
  jumlah             Decimal
  alasan             String
  status             String    @default("menunggu") // menunggu | disetujui | ditolak | dicairkan
  tanggalPengajuan   DateTime  @default(now())
  tanggalPersetujuan DateTime?
  namaPengurus       String?
  tanggalPencairan   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  anggota KoperasiAnggota @relation(fields: [koperasiAnggotaId], references: [id])
}

// ==================== KOPERASI: PINJAMAN PERBAIKAN ELIGIBILITAS ====================

model KoperasiPinjamanPerbaikan {
  id                String    @id @default(cuid())
  koperasiAnggotaId String
  alasan            String // alasan pengguna mengajukan perbaikan
  janjiPerbaikan    String? // komitmen pengguna (misal: "akan bayar tepat waktu")
  status            String    @default("menunggu") // menunggu | disetujui | ditolak
  catatanAdmin      String? // alasan admin menyetujui/menolak
  syaratTambahan    String? // syarat dari admin (misal: tunggu 3 bulan)
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  anggota    KoperasiAnggota @relation(fields: [koperasiAnggotaId], references: [id])
  reviewedBy Pengguna?       @relation("PerbaikanReviewedBy", fields: [reviewedById], references: [id])
}

// ==================== TOKO ONLINE (E-COMMERCE) ====================

// Online order with full lifecycle (menunggu_pembayaran -> dibayar -> diproses -> dikirim -> diterima)
model PesananToko {
  id                      String    @id @default(cuid())
  orderNumber             String    @unique // format: TKO-YYYYMMDD-XXXX
  // Buyer info (guest checkout, no pengguna account needed)
  buyerName               String
  buyerPhone              String
  buyerEmail              String?
  buyerAddress            String // full address JSON
  // Financial
  subtotalProduk          Decimal   @default(0)
  ongkir                  Decimal   @default(0)
  totalBayar              Decimal   @default(0)
  // Payment
  paymentMethod           String    @default("midtrans") // midtrans | manual
  paymentStatus           String    @default("menunggu") // menunggu | dibayar | gagal | dibatalkan | expired
  midtransOrderId         String?   @unique
  midtransSnapToken       String?
  paidAt                  DateTime?
  // Midtrans transaction detail (diisi oleh webhook)
  midtransTransactionId   String? // transaction_id dari Midtrans
  midtransPaymentType     String? // payment_type: credit_card, qris, bank_transfer, echannel, gopay, shopeepay, cstore, akulaku, etc.
  midtransVaNumber        String? // va_number (untuk bank_transfer / echannel)
  midtransIssuer          String? // bank issuer (bca, bni, bri, mandiri, ...)
  midtransPdfUrl          String? // pdf_url untuk instruksi pembayaran VA / CVS
  midtransStatusCode      String? // status_code terakhir dari Midtrans
  midtransGrossAmount     Decimal? // gross_amount dari callback (verifikasi)
  midtransTransactionTime DateTime? // transaction_time
  midtransSettlementTime  DateTime? // settlement_time (saat benar-benar lunas)
  midtransRawCallback     String? // snapshot JSON callback terakhir (audit/debug)
  midtransLastWebhookAt   DateTime? // terakhir kali webhook diterima untuk order ini
  // Order lifecycle
  orderStatus             String    @default("menunggu_pembayaran") // menunggu_pembayaran | dibayar | diproses | dikirim | diterima | dibatalkan | expired
  // Shipping
  kurirNama               String?
  noResi                  String?
  resiPhotoUrl            String? // foto resi pengiriman
  shippingEtaStart        DateTime? // Estimasi tiba (awal)
  shippingEtaEnd          DateTime? // Estimasi tiba (akhir)
  shippedAt               DateTime?
  receivedAt              DateTime?
  // Metadata
  notes                   String?
  createdById             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  createdBy     Pengguna?                  @relation("TokoOrderCreatedBy", fields: [createdById], references: [id])
  items         ItemPesananToko[]
  statusHistory RiwayatStatusPesananToko[]
}

model ItemPesananToko {
  id                   String   @id @default(cuid())
  pesananTokoId        String
  produkId             String
  productNameSnapshot  String
  unitSnapshot         String
  pricePerUnitSnapshot Decimal
  quantity             Decimal
  weightGramSnapshot   Int      @default(0)
  subtotal             Decimal
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  pesananToko PesananToko @relation(fields: [pesananTokoId], references: [id])
  produk      Produk      @relation(fields: [produkId], references: [id])
}

model RiwayatStatusPesananToko {
  id            String   @id @default(cuid())
  pesananTokoId String
  status        String // menunggu_pembayaran | dibayar | diproses | dikirim | diterima | dibatalkan | expired
  keterangan    String?
  createdById   String?
  createdAt     DateTime @default(now())

  pesananToko PesananToko @relation(fields: [pesananTokoId], references: [id])
  createdBy   Pengguna?   @relation("TokoStatusCreatedBy", fields: [createdById], references: [id])
}

// ==================== TOKO SETTINGS ====================

model TokoSetting {
  id                   String   @id @default(cuid())
  // Ongkir
  ongkirRatePerKg      Decimal  @default(0) // Rp per kg
  ongkirRatePerKm      Decimal  @default(0) // Rp per km (alternative)
  ongkirTetap          Decimal  @default(0) // flat rate jika tidak pakai per kg/km
  beratMinimumKg       Decimal  @default(1) // minimum berat dihitung
  // Lokasi asal pengiriman
  originLatitude       Decimal?
  originLongitude      Decimal?
  originAddress        String?
  // Midtrans
  midtransServerKey    String?
  midtransClientKey    String?
  midtransIsProduction Boolean  @default(false)
  // Stok
  stokRendahThreshold  Int      @default(5) // ambang batas notifikasi stok rendah
  // Aktif
  tokoOnlineAktif      Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ==================== ATURAN PENJUALAN (per kategori) ====================

model AturanPenjualan {
  id               String   @id @default(cuid())
  kategoriProdukId String? // null = aturan global, else per kategori
  minPembelian     Int      @default(1) // minimal qty per item dalam 1 order
  maxPembelian     Int      @default(0) // 0 = tidak ada batas
  berlakuOffline   Boolean  @default(true)
  berlakuOnline    Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category KategoriProduk? @relation(fields: [kategoriProdukId], references: [id])
}

// ==================== ARTICLES (public content, minor) ====================

model Article {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String?
  content       String
  featuredImage String?
  publishedAt   DateTime?
  authorId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  author Pengguna? @relation(fields: [authorId], references: [id])
}

// ==================== KEGIATAN (activity documentation) ====================

model Kegiatan {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  description  String?
  activityDate DateTime?
  location     String?
  images       String    @default("[]") // JSON array of image URLs
  coverImage   String?
  publishedAt  DateTime?
  authorId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  author Pengguna? @relation(fields: [authorId], references: [id])
}

// ==================== MASTER WILAYAH INDONESIA ====================
// Field `id` adalah kode wilayah Kemendagri (String). Data di-seed dari
// dataset emsifa/api-wilayah-indonesia. Field `rajaOngkirDestId` di
// District dipakai untuk caching ID tujuan RajaOngkir (Komerce) supaya
// tidak query berulang ke API luar untuk kecamatan yang sama.

model Province {
  id        String   @id // kode Kemendagri, e.g. "32"
  name      String
  altName   String?
  latitude  String?
  longitude String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cities City[]
}

model City {
  id         String   @id // kode Kemendagri, e.g. "32.73"
  provinceId String
  name       String
  altName    String?
  latitude   String?
  longitude  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  province  Province   @relation(fields: [provinceId], references: [id])
  districts District[]
}

model District {
  id               String   @id // kode Kemendagri, e.g. "32.73.01"
  cityId           String
  name             String
  altName          String?
  latitude         String?
  longitude        String?
  // Cache ID tujuan RajaOngkir (Komerce) supaya tidak query berulang
  // untuk kecamatan yang sama. Diisi lazily saat pertama kali resolve.
  rajaOngkirDestId Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  city City @relation(fields: [cityId], references: [id])

  @@index([cityId])
}

// ==================== ADMIN: DAILY TASK & REMINDER LOG ====================
model LogTugasHarianAdmin {
  id          String   @id @default(cuid())
  taskKey     String // 'pinjaman_reminders' | 'simpanan_wajib_reminder' | 'antrian_qc_verification' | 'stok_produk_monitoring'
  dateString  String // 'YYYY-MM-DD'
  action      String // 'blast_email' | 'tagih_semua' | 'manual_complete'
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([taskKey, dateString])
}

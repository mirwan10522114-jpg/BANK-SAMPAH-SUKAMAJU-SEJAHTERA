{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/backend/*": [
        "./src/backend/*"
      ],
      "@/frontend/*": [
        "./src/frontend/*"
      ],
      "@/lib/db": [
        "./src/backend/lib/db"
      ],
      "@/lib/business": [
        "./src/backend/lib/business"
      ],
      "@/lib/email": [
        "./src/backend/lib/email"
      ],
      "@/lib/rajaongkir": [
        "./src/backend/lib/rajaongkir"
      ],
      "@/lib/logger": [
        "./src/backend/lib/logger"
      ],
      "@/lib/prisma": [
        "./src/backend/lib/prisma"
      ],
      "@/lib/print-struk": [
        "./src/backend/lib/print-struk"
      ],
      "@/lib/midtrans": [
        "./src/backend/lib/midtrans"
      ],
      "@/lib/resend": [
        "./src/backend/lib/resend"
      ],
      "@/lib/api": [
        "./src/frontend/lib/api"
      ],
      "@/lib/auth": [
        "./src/frontend/lib/auth"
      ],
      "@/lib/format": [
        "./src/frontend/lib/format"
      ],
      "@/lib/utils": [
        "./src/frontend/lib/utils"
      ],
      "@/components/*": [
        "./src/frontend/components/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
